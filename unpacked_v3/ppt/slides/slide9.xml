<?xml version="1.0" encoding="utf-8"?><p:sld xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main"><p:cSld name="Slide 9"><p:bg><p:bgPr><a:solidFill><a:srgbClr val="FFFFFF"/></a:solidFill></p:bgPr></p:bg><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr><p:sp><p:nvSpPr><p:cNvPr id="2" name="Text 0"/><p:cNvSpPr/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="548640" y="384048"/><a:ext cx="11094415" cy="603504"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln/></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="ctr"/><a:lstStyle/><a:p><a:pPr algn="ctr" indent="0" marL="0"><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="3200" b="1" dirty="0"><a:solidFill><a:srgbClr val="14284B"/></a:solidFill><a:latin typeface="Times New Roman" pitchFamily="18" charset="0"/></a:rPr><a:t>Motivation of Work</a:t></a:r><a:endParaRPr lang="en-US" sz="3200" dirty="0"><a:latin typeface="Times New Roman" pitchFamily="18" charset="0"/></a:endParaRPr></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="3" name="Shape 1"/><p:cNvSpPr/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="5547208" y="1051560"/><a:ext cx="1097280" cy="45720"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:solidFill><a:srgbClr val="C9A227"/></a:solidFill><a:ln w="9525"><a:solidFill><a:srgbClr val="C9A227"/></a:solidFill><a:prstDash val="solid"/></a:ln></p:spPr></p:sp><p:sp><p:nvSpPr><p:cNvPr id="4" name="Text 2"/><p:cNvSpPr/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="10908792" y="6382512"/><a:ext cx="731520" cy="274320"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln/></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="ctr"/><a:lstStyle/><a:p><a:pPr algn="r" indent="0" marL="0"><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="2400" b="1" dirty="0"><a:solidFill><a:srgbClr val="14284B"/></a:solidFill><a:latin typeface="Times New Roman" pitchFamily="18" charset="0"/></a:rPr><a:t>9</a:t></a:r><a:endParaRPr lang="en-US" sz="2400" dirty="0"><a:latin typeface="Times New Roman" pitchFamily="18" charset="0"/></a:endParaRPr></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="5" name="Text 3"/><p:cNvSpPr/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="548640" y="6428232"/><a:ext cx="7315200" cy="219456"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln/></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="ctr"/><a:lstStyle/><a:p><a:pPr algn="l" indent="0" marL="0"><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="850" dirty="0"><a:solidFill><a:srgbClr val="8A8A8A"/></a:solidFill><a:latin typeface="Times New Roman" pitchFamily="34" charset="0"/><a:ea typeface="Calibri" pitchFamily="34" charset="-122"/><a:cs typeface="Calibri" pitchFamily="34" charset="-120"/></a:rPr><a:t>Informational estimate only — not medical or dietary advice.</a:t></a:r><a:endParaRPr lang="en-US" sz="850" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="6" name="Text 4"/><p:cNvSpPr/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="548640" y="1417320"/><a:ext cx="11094415" cy="4297680"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln/></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="t"/><a:lstStyle/><a:p><a:pPr marL="342900" indent="-342900"><a:lnSpc><a:spcPts val="2500"/></a:lnSpc><a:spcAft><a:spcPts val="1400"/></a:spcAft><a:buSzPct val="100000"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" sz="2400" b="1" dirty="0"><a:solidFill><a:srgbClr val="14284B"/></a:solidFill><a:latin typeface="Times New Roman" pitchFamily="18" charset="0"/></a:rPr><a:t>The error is multiplicative: </a:t></a:r><a:pPr indent="0" marL="0"><a:lnSpc><a:spcPts val="2500"/></a:lnSpc><a:spcAft><a:spcPts val="1400"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="2400" dirty="0"><a:solidFill><a:srgbClr val="222222"/></a:solidFill><a:latin typeface="Times New Roman" pitchFamily="18" charset="0"/></a:rPr><a:t>Total calories = identity × mass. Fixing one and guessing the other caps accuracy no matter how capable the underlying model is.</a:t></a:r><a:endParaRPr lang="en-US" sz="2400" dirty="0"><a:latin typeface="Times New Roman" pitchFamily="18" charset="0"/></a:endParaRPr></a:p><a:p><a:pPr marL="342900" indent="-342900"><a:lnSpc><a:spcPts val="2500"/></a:lnSpc><a:spcAft><a:spcPts val="1400"/></a:spcAft><a:buSzPct val="100000"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" sz="2400" b="1" dirty="0"><a:solidFill><a:srgbClr val="14284B"/></a:solidFill><a:latin typeface="Times New Roman" pitchFamily="18" charset="0"/></a:rPr><a:t>The failure is measurable: </a:t></a:r><a:pPr indent="0" marL="0"><a:lnSpc><a:spcPts val="2500"/></a:lnSpc><a:spcAft><a:spcPts val="1400"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="2400" dirty="0"><a:solidFill><a:srgbClr val="222222"/></a:solidFill><a:latin typeface="Times New Roman" pitchFamily="18" charset="0"/></a:rPr><a:t>Commercial apps report 550 kcal for a thali plate that actually contains: rice (215) + dal (140) + chapati (210) + sabzi (100) = 665 kcal — a hidden 17 % error.</a:t></a:r><a:endParaRPr lang="en-US" sz="2400" dirty="0"><a:latin typeface="Times New Roman" pitchFamily="18" charset="0"/></a:endParaRPr></a:p><a:p><a:pPr marL="342900" indent="-342900"><a:lnSpc><a:spcPts val="2500"/></a:lnSpc><a:spcAft><a:spcPts val="1400"/></a:spcAft><a:buSzPct val="100000"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" sz="2400" b="1" dirty="0"><a:solidFill><a:srgbClr val="14284B"/></a:solidFill><a:latin typeface="Times New Roman" pitchFamily="18" charset="0"/></a:rPr><a:t>Indian plates are our primary benchmark: </a:t></a:r><a:pPr indent="0" marL="0"><a:lnSpc><a:spcPts val="2500"/></a:lnSpc><a:spcAft><a:spcPts val="1400"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="2400" dirty="0"><a:solidFill><a:srgbClr val="222222"/></a:solidFill><a:latin typeface="Times New Roman" pitchFamily="18" charset="0"/></a:rPr><a:t>Thali, biryani, sambar-rice, upma, idli, poha, curd rice — IFCT 2017 covers them, but mainstream consumer apps fail to leverage it.</a:t></a:r><a:endParaRPr lang="en-US" sz="2400" dirty="0"><a:latin typeface="Times New Roman" pitchFamily="18" charset="0"/></a:endParaRPr></a:p><a:p><a:pPr marL="342900" indent="-342900"><a:lnSpc><a:spcPts val="2500"/></a:lnSpc><a:spcAft><a:spcPts val="1400"/></a:spcAft><a:buSzPct val="100000"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" sz="2400" b="1" dirty="0"><a:solidFill><a:srgbClr val="14284B"/></a:solidFill><a:latin typeface="Times New Roman" pitchFamily="18" charset="0"/></a:rPr><a:t>Uncertainty must be transparent: </a:t></a:r><a:pPr indent="0" marL="0"><a:lnSpc><a:spcPts val="2500"/></a:lnSpc><a:spcAft><a:spcPts val="1400"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="2400" dirty="0"><a:solidFill><a:srgbClr val="222222"/></a:solidFill><a:latin typeface="Times New Roman" pitchFamily="18" charset="0"/></a:rPr><a:t>Displaying ranges and calibrated confidence bands is honest; a point estimate falsely implies precision a 2D photograph cannot support.</a:t></a:r><a:endParaRPr lang="en-US" sz="2400" dirty="0"><a:latin typeface="Times New Roman" pitchFamily="18" charset="0"/></a:endParaRPr></a:p><a:p><a:pPr marL="342900" indent="-342900"><a:lnSpc><a:spcPts val="2500"/></a:lnSpc><a:spcAft><a:spcPts val="1400"/></a:spcAft><a:buSzPct val="100000"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" sz="2400" b="1" dirty="0"><a:solidFill><a:srgbClr val="14284B"/></a:solidFill><a:latin typeface="Times New Roman" pitchFamily="18" charset="0"/></a:rPr><a:t>Deployable on commodity hardware: </a:t></a:r><a:pPr indent="0" marL="0"><a:lnSpc><a:spcPts val="2500"/></a:lnSpc><a:spcAft><a:spcPts val="1400"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="2400" dirty="0"><a:solidFill><a:srgbClr val="222222"/></a:solidFill><a:latin typeface="Times New Roman" pitchFamily="18" charset="0"/></a:rPr><a:t>Runs on a standard CPU-only laptop using SQLite + Chroma, with a deterministic mock mode ensuring complete examiner reproducibility.</a:t></a:r><a:endParaRPr lang="en-US" sz="2400" dirty="0"><a:latin typeface="Times New Roman" pitchFamily="18" charset="0"/></a:endParaRPr></a:p><a:p><a:pPr marL="342900" indent="-342900"><a:lnSpc><a:spcPts val="2500"/></a:lnSpc><a:spcAft><a:spcPts val="1400"/></a:spcAft><a:buSzPct val="100000"/><a:buChar char="•"/></a:pPr><a:r><a:rPr lang="en-US" sz="2400" b="1" dirty="0"><a:solidFill><a:srgbClr val="14284B"/></a:solidFill><a:latin typeface="Times New Roman" pitchFamily="18" charset="0"/></a:rPr><a:t>A clear academic and clinical gap: </a:t></a:r><a:pPr indent="0" marL="0"><a:lnSpc><a:spcPts val="2500"/></a:lnSpc><a:spcAft><a:spcPts val="1400"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="2400" dirty="0"><a:solidFill><a:srgbClr val="222222"/></a:solidFill><a:latin typeface="Times New Roman" pitchFamily="18" charset="0"/></a:rPr><a:t>No published system unifies component decomposition, database-grounded retrieval, calibrated confidence, and targeted clarification.</a:t></a:r><a:endParaRPr lang="en-US" sz="2400" dirty="0"><a:latin typeface="Times New Roman" pitchFamily="18" charset="0"/></a:endParaRPr></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="7" name="Shape 5"/><p:cNvSpPr/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="548640" y="5806440"/><a:ext cx="11094415" cy="502920"/></a:xfrm><a:prstGeom prst="roundRect"><a:avLst><a:gd name="adj" fmla="val 9091"/></a:avLst></a:prstGeom><a:solidFill><a:srgbClr val="DDF1EF"/></a:solidFill><a:ln w="12700"><a:solidFill><a:srgbClr val="2A8C8C"/></a:solidFill><a:prstDash val="solid"/></a:ln></p:spPr></p:sp><p:sp><p:nvSpPr><p:cNvPr id="8" name="Text 6"/><p:cNvSpPr/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="777240" y="5806440"/><a:ext cx="10637215" cy="502920"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln/></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="ctr"/><a:lstStyle/><a:p><a:pPr algn="ctr" indent="0" marL="0"><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="2400" b="1" dirty="0"><a:solidFill><a:srgbClr val="2A8C8C"/></a:solidFill><a:latin typeface="Times New Roman" pitchFamily="18" charset="0"/></a:rPr><a:t>Core Research Question: </a:t></a:r><a:pPr algn="ctr" indent="0" marL="0"><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="2400" dirty="0"><a:solidFill><a:srgbClr val="222222"/></a:solidFill><a:latin typeface="Times New Roman" pitchFamily="18" charset="0"/></a:rPr><a:t>Can decomposing meal components, grounding each in composition databases, and clarifying only when uncertain beat a confident one-shot guess?</a:t></a:r><a:endParaRPr lang="en-US" sz="2400" dirty="0"><a:latin typeface="Times New Roman" pitchFamily="18" charset="0"/></a:endParaRPr></a:p></p:txBody></p:sp></p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr></p:sld>